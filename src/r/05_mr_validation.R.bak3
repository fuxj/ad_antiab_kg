#!/usr/bin/env Rscript
# =============================================================================
# 05_mr_validation.R  --  Chapter 5: Mendelian randomization (MR) triangulation
# -----------------------------------------------------------------------------
# Project : AD anti-amyloid drug safety  (FAERS + KG + GNN + MR)
# Purpose : Take the candidate genes surfaced by Chapter 4 (interpretable GNN)
#           and test, with two-sample MR using cis-eQTL instruments, whether
#           genetically proxied gene expression causally affects:
#             (a) Alzheimer's disease risk          -> efficacy axis
#             (b) intracerebral / subarachnoid bleed -> ARIA-H safety axis
#           i.e. push "association" towards "causation", closing the
#           cross-source triangulation loop.
#
# Data    : IEU OpenGWAS REST API (https://api.opengwas.io/api).
#           Since 2024-05-01 a free JWT token is REQUIRED.
#           Register (free) at https://api.opengwas.io/profile/ and either
#           export OPENGWAS_JWT=<token>  or pass --token <token>.
#
# Deps    : base R (>=4.1) + jsonlite only.  HTTP is done through the system
#           `curl` binary, so no httr / TwoSampleMR / ieugwasr install needed.
#           All MR statistics are implemented natively and unit-verified by
#           `--stage selftest`.
#
# Stages  : probe | fetch | analyse | all | selftest
#
# Every dataset ID baked into this script was verified against the public
# OpenGWAS catalogue dump (opengwas.io/data/gwasinfo/gwasinfo.json, 50,066
# datasets) at build time.  Genes without an eQTLGen dataset are excluded
# from the default panel on purpose (see GENE_PANEL below).
# =============================================================================

suppressWarnings(suppressMessages({
  options(stringsAsFactors = FALSE, warn = -1)
}))

VERSION <- "1.0.0"
CRAN_MIRROR <- "https://mirrors.tuna.tsinghua.edu.cn/CRAN/"
MAX_TIME <- "180"

