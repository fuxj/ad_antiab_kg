#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
08_gnn_linkpred_hgt.py -- Chapter 6: heterogeneous graph link prediction
                          (HGT) for drug repurposing & combination therapy.

Project : AD anti-amyloid drug (lecanemab / donanemab) ARIA safety
          -- multimodal knowledge graph + interpretable GNN + MR triangulation.

Goal of this chapter
    Chapter 4 built an extended multimodal KG (drug / gene / pathway /
    indication / adverse-event, six relation types) and trained an R-GCN to
    rank candidate drugs against ARIA concepts.  That model answered only one
    question ("which old drugs might be risky together with anti-Abeta
    antibodies?").  Here we move from a single binary task to **link
    prediction on the whole heterogeneous graph** with a Heterogeneous Graph
    Transformer (HGT), then read three clinically actionable predictions out
    of the same trained model:

        (A) Drug repurposing  -- score (drug, drug_indication, Alzheimer_disease)
        (B) Combination / risk mitigation
                              -- score (drug, drug_ae, ARIA/ICH concepts);
                                 low score = unlikely to add bleeding risk
        (C) Combination / efficacy boost
                              -- drug -> target gene -> pathway routes that hit
                                 amyloid-clearance / microglia-activation programs

    Final candidates are produced by fusing four independent evidence layers:
        1. HGT link-prediction probability (this script)
        2. Mendelian randomization target evidence (Chapter 5, mr_summary.csv)
        3. Cross-tissue colocalization verdict (Chapter 5, coloc_brain_vs_blood.csv)
        4. FAERS pharmacovigilance signal + CNS flag (Chapters 2/4)

Design notes / why this is not a re-run of Chapter 4
    * Chapter 4 R-GCN test AUC was ~0.53 (near random).  Root causes:
      (i) node features were 27-dim one-hot + degree, (ii) single
      drug->AE binary task discarded the rest of the heterogeneous graph,
      (iii) trivial negative sampling.
    * Here: HGT with type-specific learnable embeddings, multi-relation
      link prediction over all six relations, per-relation negative
      sampling, strict train/val/test edge split, and **no test edge ever
      participates in message passing** (the classic leakage a reviewer
      will look for).  gene_ae edges are re-derived from training drug_ae
      edges only, so they cannot smuggle held-out drug_ae information.

Stages  : probe | train | predict | all
Deps    : torch>=2.0, torch_geometric>=2.4, pandas, numpy, scikit-learn,
          matplotlib, pyarrow.

Usage
    python 08_gnn_linkpred_hgt.py probe   --proj .
    python 08_gnn_linkpred_hgt.py train   --proj . --epochs 200 --device cuda
    python 08_gnn_linkpred_hgt.py predict --proj .
    python 08_gnn_linkpred_hgt.py all     --proj .
"""

import argparse
import json
import os
import random
import re
import sys
import time
from collections import Counter, defaultdict
from datetime import datetime
from pathlib import Path

import numpy as np
import pandas as pd

# =============================================================================
# 0. Constants
# =============================================================================

VERSION = "1.0.0"

NODE_TYPES = ["Drug", "Gene", "Pathway", "Indication", "AdverseEvent"]

# The six forward relations that exist in kg_ext.
REL_TYPES = ["drug_target", "drug_indication", "drug_ae",
             "gene_pathway", "gene_indication", "gene_ae"]

# Relations that are used directly for scoring clinical tasks.
PREDICT_REL = ["drug_indication", "drug_ae", "drug_target"]

# ARIA / intracranial-bleeding adverse-event concepts (node ids start with AE:)
ARIA_AE_KEYS = ("aria", "cerebral_hemorrhage", "cerebral_microhemorrhage",
                "superficial_siderosis", "cerebral_edema", "brain_edema",
                "hemorrhage")

# Alzheimer indication node id substring
AD_IND_KEYS = ("alzheimer",)

# Pathway name keywords implying amyloid clearance / microglia activation
SYNERGY_KWS = (
    "amyloid", "microglia", "microglial", "phagocyt", "complement",
    "immune", "immun", "lysosom", "endosom", "autophag", "tau",
    "neuroinflamm", "trem2", "apoe", "lipid", "synap", "proteasom",
    "proteas", "glymphatic", "clearance", "microglial", "innate",
    "cytokine", "interferon", "apopt", "efferocyt", "antigen",
)

# Curated AD GWAS / drug-target genes used as a small, transparent
# biological prior (NOT used for training; only for interpretable ranking).
AD_PRIOR_GENES = {
    "APOE", "BIN1", "CLU", "ABCA7", "CR1", "PICALM", "MS4A6A", "MS4A4E",
    "CD33", "TREM2", "PLCG2", "ABI3", "SORL1", "ADAM10", "ACE", "APP",
    "PSEN1", "PSEN2", "MAPT", "GSK3B", "INPP5D", "SPI1", "MS4A4A",
    "SORL1", "EPHA1", "CD2AP", "HLA-DRB1", "PTK2B", "SLC24A4", "ZCWPW1",
    "CASS4", "FERMT2", "ECHDC3", "ACE", "MME", "IDE", "LRP1", "AGER",
}


# =============================================================================
# 1. small utilities
# =============================================================================

def log(fmt, *a):
    ts = datetime.now().strftime("%H:%M:%S")
    print(("[%s] " % ts) + (fmt % a if a else fmt), flush=True)


def die(fmt, *a):
    log("ERROR: " + (fmt % a if a else fmt))
    sys.exit(1)


def human(n):
    try:
        return "{:,}".format(int(n))
    except Exception:
        return str(n)


def find_proj_root(start=None):
    p = Path(start or Path.cwd()).resolve()
    for _ in range(8):
        if (p / "src").exists() or (p / "data").exists() or (p / "results").exists():
            return p
        if p.parent == p:
            break
        p = p.parent
    return Path(start or Path.cwd()).resolve()


def check_disk(path, min_free_gb=2.0):
    try:
        import shutil
        free = shutil.disk_usage(str(path)).free / (1024 ** 3)
    except Exception:
        return True
    if free < min_free_gb:
        die("free disk %.1f GB < threshold %d GB, aborted", free, min_free_gb)
    return True


# =============================================================================
# 2. graph loading
# =============================================================================

def load_kg(proj):
    kgd = proj / "data" / "processed" / "kg_ext"
    npath, epath = kgd / "nodes.parquet", kgd / "edges.parquet"
    if not npath.exists() or not epath.exists():
        die("kg_ext not found at %s. Run Chapter 4 build stage first.", kgd)
    ndf = pd.read_parquet(npath)
    edf = pd.read_parquet(epath)
    return ndf, edf


def build_graph(ndf, edf):
    """Return node bookkeeping plus forward edge dict."""
    node_ids = ndf["node_id"].tolist()
    node_types = ndf["node_type"].tolist()
    ntype_of = dict(zip(node_ids, node_types))

    type_ids = {t: [] for t in NODE_TYPES}
    loc = {}
    for nid, t in zip(node_ids, node_types):
        if t not in type_ids:
            continue
        loc[nid] = len(type_ids[t])
        type_ids[t].append(nid)

    fwd = defaultdict(list)
    for r in edf.itertuples(index=False):
        s = getattr(r, "src")
        d = getattr(r, "dst")
        rel = getattr(r, "edge_type")
        if rel not in REL_TYPES:
            continue
        if s not in loc or d not in loc:
            continue
        st, dt = ntype_of[s], ntype_of[d]
        if st not in NODE_TYPES or dt not in NODE_TYPES:
            continue
        fwd[(st, rel, dt)].append((loc[s], loc[d]))

    return node_ids, ntype_of, loc, type_ids, dict(fwd)


def edge_index_tensor(pairs, device="cpu"):
    import torch
    if not pairs:
        return torch.zeros((2, 0), dtype=torch.long, device=device)
    return torch.tensor(pairs, dtype=torch.long, device=device).t().contiguous()


def build_edge_index_dict(fwd, device="cpu"):
    """Build { (stype, rel, dtype): edge_index } with forward + reverse edges."""
    d = {}
    for (st, rel, dt), pairs in fwd.items():
        if pairs:
            ei = edge_index_tensor(pairs, device)
            d[(st, rel, dt)] = ei
            d[(dt, rel + "_rev", st)] = ei.flip(0)
        else:
            d[(st, rel, dt)] = edge_index_tensor([], device)
            d[(dt, rel + "_rev", st)] = edge_index_tensor([], device)
    return d


# =============================================================================
# 3. train / val / test split (per relation, no leakage)
# =============================================================================

def split_edges(fwd, seed=42, val_frac=0.10, test_frac=0.10, min_train=1):
    """Split each forward relation into train / val / test.
    Return (fwd_train, fwd_val, fwd_test) dicts with same keys."""
    rng = np.random.RandomState(seed)
    tr, va, te = {}, {}, {}
    for key, pairs in fwd.items():
        arr = np.array(pairs, dtype=np.int64) if pairs else np.zeros((0, 2), dtype=np.int64)
        n = len(arr)
        if n == 0:
            tr[key], va[key], te[key] = [], [], []
            continue
        perm = rng.permutation(n)
        n_te = int(round(test_frac * n))
        n_va = int(round(val_frac * n))
        # guarantee at least `min_train` training edges when possible
        if n - n_te - n_va < min_train and n >= 3:
            deficit = min_train - (n - n_te - n_va)
            take = min(deficit, n_va)
            n_va -= take
            deficit -= take
            if deficit > 0:
                n_te = max(0, n_te - deficit)
        idx_tr = perm[: n - n_te - n_va]
        idx_va = perm[n - n_te - n_va: n - n_te]
        idx_te = perm[n - n_te:]
        tr[key] = [tuple(x) for x in arr[idx_tr]]
        va[key] = [tuple(x) for x in arr[idx_va]]
        te[key] = [tuple(x) for x in arr[idx_te]]
    return tr, va, te


# =============================================================================
# 4. HGT model
# =============================================================================

def build_model(type_sizes, metadata, hidden, out_dim, heads, layers, dropout,
                n_rel, device):
    import torch
    import torch.nn as nn
    import torch.nn.functional as F
    from torch_geometric.nn import HGTConv

    class HGTEncoder(nn.Module):
        def __init__(self):
            super().__init__()
            self.emb = nn.ModuleDict(
                {nt: nn.Embedding(type_sizes[nt], hidden) for nt in NODE_TYPES})
            for m in self.emb:
                nn.init.xavier_uniform_(self.emb[m].weight)
            self.convs = nn.ModuleList()
            self.norms = nn.ModuleList()
            for i in range(layers):
                cin = hidden if i == 0 else out_dim
                self.convs.append(HGTConv(cin, out_dim, metadata, heads))
                self.norms.append(nn.LayerNorm(out_dim))
            self.drop = nn.Dropout(dropout)

        def encode(self, edge_index_dict):
            x = {nt: F.relu(self.emb[nt].weight) for nt in self.emb}
            for conv, norm in zip(self.convs, self.norms):
                x = conv(x, edge_index_dict)
                x = {k: self.drop(F.relu(norm(v))) for k, v in x.items()}
            return x

    class DistMult(nn.Module):
        def __init__(self):
            super().__init__()
            self.rel = nn.Embedding(n_rel, out_dim)
            nn.init.xavier_uniform_(self.rel.weight)

        def score(self, z, heads, tails, stype, dtype, rel_id):
            import torch
            zh = z[stype][heads]
            zt = z[dtype][tails]
            r = self.rel(torch.full_like(heads, rel_id))
            return (zh * r * zt).sum(-1)

    enc = HGTEncoder().to(device)
    dec = DistMult().to(device)
    return enc, dec


# =============================================================================
# 5. probe
# =============================================================================

def stage_probe(proj, args):
    log("=== STAGE probe (chapter 6 HGT) ===")
    try:
        import torch
        from torch_geometric.nn import HGTConv  # noqa: F401
        log("torch %s | cuda available: %s", torch.__version__,
            torch.cuda.is_available())
    except Exception as e:
        die("torch / torch_geometric import failed: %s", e)

    ndf, edf = load_kg(proj)
    node_ids, ntype_of, loc, type_ids, fwd = build_graph(ndf, edf)

    log("nodes total: %s", human(len(node_ids)))
    for t in NODE_TYPES:
        log("  node %-13s %s", t, human(len(type_ids[t])))
    log("edges total: %s", human(len(edf)))
    for t in REL_TYPES:
        c = sum(len(v) for k, v in fwd.items() if k[1] == t)
        log("  edge %-16s %s", t, human(c))

    ad_inds = [nid for nid in type_ids["Indication"]
               if any(k in nid.lower() for k in AD_IND_KEYS)]
    log("AD indication node(s): %s", ad_inds if ad_inds else "NOT FOUND")

    aria_ae = [nid for nid in type_ids["AdverseEvent"]
               if any(k in nid.lower() for k in ARIA_AE_KEYS)]
    log("ARIA/ICH AE node(s): %d found", len(aria_ae))
    for nid in aria_ae[:12]:
        log("    %s", nid)

    target_drugs = [nid for nid in type_ids["Drug"]
                    if nid in ("DRUG:CHEMBL3833321", "DRUG:CHEMBL4297245",
                               "DRUG:CHEMBL3039540")]
    log("target antibody drugs present: %s", target_drugs)

    cand = proj / "data" / "interim" / "kg_ext" / "candidate_drugs.csv"
    log("candidate_drugs.csv: %s", "yes" if cand.exists() else "no")

    mr = proj / "results" / "tables" / "mr_summary.csv"
    cb = proj / "results" / "tables" / "coloc_brain_vs_blood.csv"
    log("mr_summary.csv: %s | coloc_brain_vs_blood.csv: %s",
        "yes" if mr.exists() else "no", "yes" if cb.exists() else "no")

    if not ad_inds:
        die("Alzheimer indication node not found -- check kg_ext nodes.parquet")
    log("probe OK -- HGT link prediction is ready")
    return True


# =============================================================================
# 6. train
# =============================================================================

def _neg_sample(rng, n, pool):
    return np.array([pool[rng.randint(0, len(pool))] for _ in range(n)],
                    dtype=np.int64)


def stage_train(proj, args):
    import torch
    import torch.nn as nn
    import torch.nn.functional as F
    from sklearn.metrics import roc_auc_score, average_precision_score

    random.seed(args.seed)
    np.random.seed(args.seed)
    torch.manual_seed(args.seed)

    ndf, edf = load_kg(proj)
    node_ids, ntype_of, loc, type_ids, fwd = build_graph(ndf, edf)
    log("[data] nodes %s | edges %s", human(len(node_ids)), human(len(edf)))

    tr, va, te = split_edges(fwd, seed=args.seed,
                             val_frac=args.val_frac, test_frac=args.test_frac)
    log("[split] relations -> train / val / test")
    for key in sorted(tr, key=lambda k: (k[1], k[0], k[2])):
        log("   %-40s %6d / %5d / %5d", "%s-%s->%s" % key,
            len(tr[key]), len(va[key]), len(te[key]))
    if all(len(tr[k]) == 0 for k in tr):
        die("no training edges at all -- check kg_ext")

    # message-passing graph uses TRAIN edges only
    fwd_train = {k: tr[k] for k in tr}
    edge_index_dict = build_edge_index_dict(fwd_train, device=args.device)
    metadata = (NODE_TYPES, list(edge_index_dict.keys()))

    type_sizes = {t: len(type_ids[t]) for t in NODE_TYPES}
    rel_id = {r: i for i, r in enumerate(REL_TYPES)}

    enc, dec = build_model(type_sizes, metadata, args.hidden, args.dim,
                           args.heads, args.layers, args.dropout,
                           len(REL_TYPES), args.device)
    params = list(enc.parameters()) + list(dec.parameters())
    opt = torch.optim.Adam(params, lr=args.lr, weight_decay=1e-5)
    log("[model] HGT params %s | hidden=%d out=%d heads=%d layers=%d device=%s",
        human(sum(p.numel() for p in params)), args.hidden, args.dim,
        args.heads, args.layers, args.device)

    # pools for negative sampling (node locals of head/tail type)
    def pools_for(key):
        st, rel, dt = key
        return type_ids[st], type_ids[dt]

    def make_pos(key):
        arr = np.array(tr[key], dtype=np.int64) if tr[key] else np.zeros((0, 2), np.int64)
        return arr

    rng = np.random.RandomState(args.seed)
    best = {"auc": -1.0, "epoch": -1, "state": None}
    hist = []
    bad = 0

    for ep in range(1, args.epochs + 1):
        enc.train(); dec.train()
        z = enc.encode(edge_index_dict)
        opt.zero_grad()
        total_loss = 0.0
        total_pos = 0
        for key in sorted(tr):
            pos = make_pos(key)
            if len(pos) == 0:
                continue
            if len(pos) > args.max_pos_per_rel:
                sel = rng.choice(len(pos), args.max_pos_per_rel, replace=False)
                pos = pos[sel]
            st, rel, dt = key
            _, dt_pool = pools_for(key)
            neg_tail = _neg_sample(rng, len(pos), np.arange(type_sizes[dt]))
            heads = torch.as_tensor(pos[:, 0], dtype=torch.long, device=args.device)
            tails_p = torch.as_tensor(pos[:, 1], dtype=torch.long, device=args.device)
            tails_n = torch.as_tensor(neg_tail, dtype=torch.long, device=args.device)
            sp = dec.score(z, heads, tails_p, st, dt, rel_id[rel])
            sn = dec.score(z, heads, tails_n, st, dt, rel_id[rel])
            logits = torch.cat([sp, sn])
            y = torch.cat([torch.ones(len(sp)), torch.zeros(len(sn))]).to(args.device)
            loss = F.binary_cross_entropy_with_logits(logits, y)
            total_loss = total_loss + loss
            total_pos += len(pos)
        total_loss.backward()
        opt.step()

        if ep % args.eval_every == 0 or ep == args.epochs:
            enc.eval(); dec.eval()
            with torch.no_grad():
                zz = enc.encode(edge_index_dict)
                aucs, aps = [], []
                for key in sorted(va):
                    if len(va[key]) == 0:
                        continue
                    arr = np.array(va[key], dtype=np.int64)
                    st, rel, dt = key
                    neg_tail = _neg_sample(rng, len(arr), np.arange(type_sizes[dt]))
                    heads = torch.as_tensor(arr[:, 0], dtype=torch.long, device=args.device)
                    tp = torch.as_tensor(arr[:, 1], dtype=torch.long, device=args.device)
                    tn = torch.as_tensor(neg_tail, dtype=torch.long, device=args.device)
                    sp = dec.score(zz, heads, tp, st, dt, rel_id[rel]).cpu().numpy()
                    sn = dec.score(zz, heads, tn, st, dt, rel_id[rel]).cpu().numpy()
                    yy = np.concatenate([np.ones(len(sp)), np.zeros(len(sn))])
                    ss = np.concatenate([sp, sn])
                    aucs.append(roc_auc_score(yy, ss))
                    aps.append(average_precision_score(yy, ss))
                m_auc = float(np.mean(aucs)) if aucs else 0.0
                m_ap = float(np.mean(aps)) if aps else 0.0
            hist.append({"epoch": ep, "loss": float(total_loss.item()),
                         "val_auc": m_auc, "val_ap": m_ap})
            if m_auc > best["auc"] + 1e-6:
                best = {"auc": m_auc, "epoch": ep,
                        "state": {"enc": {k: v.detach().cpu().clone() for k, v in enc.state_dict().items()},
                                  "dec": {k: v.detach().cpu().clone() for k, v in dec.state_dict().items()}}}
                bad = 0
            else:
                bad += 1
            if ep % (args.eval_every * 5) == 0 or ep == args.epochs:
                log("  epoch %4d | loss %.4f | val AUC %.4f | val AP %.4f",
                    ep, float(total_loss.item()), m_auc, m_ap)
            if bad >= args.patience:
                log("  [early stop] no val improvement for %d evals at epoch %d",
                    args.patience, ep)
                break

    # ---- test evaluation (message passing on TRAIN edges only) ----
    enc.load_state_dict(best["state"]["enc"])
    dec.load_state_dict(best["state"]["dec"])
    enc.eval(); dec.eval()
    test_rows = []
    with torch.no_grad():
        zz = enc.encode(edge_index_dict)
        for key in sorted(te):
            if len(te[key]) == 0:
                continue
            arr = np.array(te[key], dtype=np.int64)
            st, rel, dt = key
            rng2 = np.random.RandomState(args.seed + 7)
            neg_tail = _neg_sample(rng2, len(arr), np.arange(type_sizes[dt]))
            heads = torch.as_tensor(arr[:, 0], dtype=torch.long, device=args.device)
            tp = torch.as_tensor(arr[:, 1], dtype=torch.long, device=args.device)
            tn = torch.as_tensor(neg_tail, dtype=torch.long, device=args.device)
            sp = dec.score(zz, heads, tp, st, dt, rel_id[rel]).cpu().numpy()
            sn = dec.score(zz, heads, tn, st, dt, rel_id[rel]).cpu().numpy()
            yy = np.concatenate([np.ones(len(sp)), np.zeros(len(sn))])
            ss = np.concatenate([sp, sn])
            auc = float(roc_auc_score(yy, ss))
            ap = float(average_precision_score(yy, ss))
            test_rows.append({"relation": "%s-%s->%s" % key, "n_test": len(arr),
                              "auc_roc": auc, "auc_pr": ap})
            log("  [test] %-40s AUC %.4f | AP %.4f", "%s-%s->%s" % key, auc, ap)

    mean_test_auc = float(np.mean([r["auc_roc"] for r in test_rows])) if test_rows else 0.0

    # ---- save model ----
    mdir = proj / "models" / "gnn_hgt"
    mdir.mkdir(parents=True, exist_ok=True)
    torch.save({
        "state_dict": {"enc": enc.state_dict(), "dec": dec.state_dict()},
        "config": {"type_sizes": type_sizes, "hidden": args.hidden, "dim": args.dim,
                   "heads": args.heads, "layers": args.layers,
                   "n_rel": len(REL_TYPES), "rel_types": REL_TYPES},
        "meta_edge_types": [list(k) for k in edge_index_dict.keys()],
        "node_ids": node_ids,
    }, mdir / "hgt_linkpred.pt")

    tdir = proj / "results" / "tables"
    tdir.mkdir(parents=True, exist_ok=True)
    metrics = {
        "version": VERSION,
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "n_nodes": int(len(node_ids)),
        "n_edges": int(len(edf)),
        "best_epoch": best["epoch"],
        "best_val_auc": float(best["auc"]),
        "mean_test_auc": mean_test_auc,
        "test_by_relation": test_rows,
        "history": hist,
        "config": {"hidden": args.hidden, "dim": args.dim, "heads": args.heads,
                   "layers": args.layers, "epochs": args.epochs,
                   "seed": args.seed, "device": args.device},
    }
    (tdir / "gnn_hgt_metrics.json").write_text(
        json.dumps(metrics, ensure_ascii=False, indent=2), encoding="utf-8")
    pd.DataFrame(test_rows).to_csv(tdir / "gnn_hgt_test_by_relation.csv", index=False)

    log("[done] best epoch %d | best val AUC %.4f | mean test AUC %.4f",
        best["epoch"], best["auc"], mean_test_auc)
    if mean_test_auc < 0.6:
        log("[note] mean test AUC below 0.60 -- graph signal is weak at this "
            "scale. Report metrics honestly; the fusion step (MR + coloc + "
            "FAERS) carries the clinical claim, GNN is a ranking prior.")
    return metrics


# =============================================================================
# 7. predict + evidence fusion
# =============================================================================

def _load_model(proj, args):
    import torch
    ckpt_path = proj / "models" / "gnn_hgt" / "hgt_linkpred.pt"
    if not ckpt_path.exists():
        die("model not found at %s. Run train stage first.", ckpt_path)
    ckpt = torch.load(ckpt_path, map_location=args.device, weights_only=False)
    cfg = ckpt["config"]
    type_sizes = cfg["type_sizes"]
    meta = (NODE_TYPES, [tuple(k) for k in ckpt["meta_edge_types"]])
    enc, dec = build_model(type_sizes, meta, cfg["hidden"], cfg["dim"],
                           cfg["heads"], cfg["layers"], 0.0,
                           cfg["n_rel"], args.device)
    enc.load_state_dict(ckpt["state_dict"]["enc"])
    dec.load_state_dict(ckpt["state_dict"]["dec"])
    enc.eval(); dec.eval()
    return enc, dec, cfg, ckpt


def _read_table(path, **kw):
    if not path.exists():
        return None
    try:
        return pd.read_csv(path, **kw)
    except Exception as e:
        log("  [warn] cannot read %s: %s", path.name, str(e)[:100])
        return None


def stage_predict(proj, args):
    import torch

    ndf, edf = load_kg(proj)
    node_ids, ntype_of, loc, type_ids, fwd = build_graph(ndf, edf)
    tr, va, te = split_edges(fwd, seed=args.seed,
                             val_frac=args.val_frac, test_frac=args.test_frac)

    # rebuild message passing graph exactly as in training (train edges only)
    fwd_train = {k: tr[k] for k in tr}
    edge_index_dict = build_edge_index_dict(fwd_train, device=args.device)

    enc, dec, cfg, ckpt = _load_model(proj, args)
    rel_id = {r: i for i, r in enumerate(REL_TYPES)}
    type_sizes = cfg["type_sizes"]

    with torch.no_grad():
        z = enc.encode(edge_index_dict)

    name_of = dict(zip(node_ids, ndf["name"].tolist()))

    # ------------------------------------------------ Task A: repurposing
    ad_nodes = [nid for nid in type_ids["Indication"]
                if any(k in nid.lower() for k in AD_IND_KEYS)]
    if not ad_nodes:
        die("no AD indication node")
    ad_local = [loc[nid] for nid in ad_nodes]

    known_dind = set()
    for k, pairs in fwd.items():
        if k[1] == "drug_indication":
            for s, d in pairs:
                known_dind.add((s, d))

    drug_locals = np.arange(type_sizes["Drug"])
    rows_a = []
    with torch.no_grad():
        for al in ad_local:
            tgt = torch.full((len(drug_locals),), al, dtype=torch.long, device=args.device)
            heads = torch.as_tensor(drug_locals, dtype=torch.long, device=args.device)
            sc = torch.sigmoid(dec.score(z, heads, tgt, "Drug", "Indication",
                                         rel_id["drug_indication"])).cpu().numpy()
            for i, dl in enumerate(drug_locals):
                nid = type_ids["Drug"][dl]
                rows_a.append({
                    "drug_id": nid,
                    "drug": name_of.get(nid, nid),
                    "indication_id": type_ids["Indication"][al],
                    "known_indication": int((dl, al) in known_dind),
                    "gnn_repurpose_score": float(sc[i]),
                })
    df_a = pd.DataFrame(rows_a)
    # for each drug keep the best-scoring AD node (usually only one)
    df_a = (df_a.sort_values("gnn_repurpose_score", ascending=False)
                 .groupby("drug_id", as_index=False).first()
                 .sort_values("gnn_repurpose_score", ascending=False)
                 .reset_index(drop=True))
    df_a["rank"] = np.arange(1, len(df_a) + 1)
    log("[A] repurposing scored: %s drugs vs AD indication", human(len(df_a)))

    # ------------------------------------------------ Task B: safety / mitigation
    aria_nodes = [nid for nid in type_ids["AdverseEvent"]
                  if any(k in nid.lower() for k in ARIA_AE_KEYS)]
    rows_b = []
    with torch.no_grad():
        if aria_nodes:
            al = [loc[x] for x in aria_nodes]
            tgt = torch.as_tensor(al, dtype=torch.long, device=args.device)
            for dl in drug_locals:
                nid = type_ids["Drug"][dl]
                heads = torch.full((len(al),), dl, dtype=torch.long, device=args.device)
                sc = torch.sigmoid(dec.score(z, heads, tgt, "Drug", "AdverseEvent",
                                             rel_id["drug_ae"])).cpu().numpy()
                rows_b.append({
                    "drug_id": nid,
                    "drug": name_of.get(nid, nid),
                    "max_aria_risk": float(np.max(sc)),
                    "mean_aria_risk": float(np.mean(sc)),
                    "n_aria_concepts": int(len(al)),
                })
    df_b = pd.DataFrame(rows_b)
    df_b["gnn_mitigation_score"] = 1.0 - df_b["max_aria_risk"]  # higher = safer
    df_b = df_b.sort_values("gnn_mitigation_score", ascending=False).reset_index(drop=True)
    df_b["rank"] = np.arange(1, len(df_b) + 1)
    log("[B] mitigation scored: %s drugs vs %s ARIA/ICH concepts",
        human(len(df_b)), len(aria_nodes))

    # ------------------------------------------------ Task C: efficacy synergy
    d2g = defaultdict(set)
    g2p = defaultdict(set)
    for k, pairs in fwd.items():
        if k[1] == "drug_target":
            for s, d in pairs:
                d2g[type_ids["Drug"][s]].add(type_ids["Gene"][d])
        elif k[1] == "gene_pathway":
            for s, d in pairs:
                g2p[type_ids["Gene"][s]].add(type_ids["Pathway"][d])

    rows_c = []
    for dl in drug_locals:
        nid = type_ids["Drug"][dl]
        genes = d2g.get(nid, set())
        syms = {name_of.get(g, g).upper() for g in genes}
        hit_prior = syms & AD_PRIOR_GENES
        hit_pw = set()
        for g in genes:
            for p in g2p.get(g, set()):
                pname = (name_of.get(p, p) or "").lower()
                if any(kw in pname for kw in SYNERGY_KWS):
                    hit_pw.add(name_of.get(p, p))
        rows_c.append({
            "drug_id": nid,
            "drug": name_of.get(nid, nid),
            "n_targets": int(len(genes)),
            "n_ad_prior_targets": int(len(hit_prior)),
            "ad_prior_targets": ",".join(sorted(hit_prior)),
            "n_synergy_pathways": int(len(hit_pw)),
            "synergy_pathways": ",".join(sorted(hit_pw)[:10]),
        })
    df_c = pd.DataFrame(rows_c)
    df_c["gnn_synergy_score"] = (
        0.5 * np.log1p(df_c["n_synergy_pathways"]) +
        0.5 * np.log1p(df_c["n_ad_prior_targets"]))
    df_c = df_c.sort_values("gnn_synergy_score", ascending=False).reset_index(drop=True)
    df_c["rank"] = np.arange(1, len(df_c) + 1)
    log("[C] synergy scored: %s drugs by target/pathway routes", human(len(df_c)))

    # ------------------------------------------------ evidence fusion
    tdir = proj / "results" / "tables"
    tdir.mkdir(parents=True, exist_ok=True)

    mr = _read_table(tdir / "mr_summary.csv")
    coloc = _read_table(tdir / "coloc_brain_vs_blood.csv")
    faers = _read_table(tdir / "faers_pt_level_signals.csv")
    cand = _read_table(proj / "data" / "interim" / "kg_ext" / "candidate_drugs.csv")

    mr_sig_genes = set()
    if mr is not None:
        gcol = "gene" if "gene" in mr.columns else mr.columns[0]
        if "p_bonferroni" in mr.columns:
            sub = mr[mr["p_bonferroni"].astype(float) < 0.05]
        elif "pval" in mr.columns:
            sub = mr[mr["pval"].astype(float) < 0.05]
        else:
            sub = mr.iloc[0:0]
        mr_sig_genes = set(sub[gcol].astype(str).str.upper())

    coloc_genes = set()
    if coloc is not None:
        gcol = "gene" if "gene" in coloc.columns else coloc.columns[0]
        if "best_brain_PP_H4" in coloc.columns:
            sub = coloc[coloc["best_brain_PP_H4"].astype(float) >= 0.8]
            coloc_genes = set(sub[gcol].astype(str).str.upper())

    cns_map, faers_aria_map = {}, {}
    if cand is not None and "name" in cand.columns and "is_cns" in cand.columns:
        cns_map = {str(r["name"]).upper(): int(r["is_cns"]) for _, r in cand.iterrows()}
    if faers is not None and "drug" in faers.columns:
        grpcol = None
        for c in ("event_group", "aria_concept", "concept"):
            if c in faers.columns:
                grpcol = c
                break
        for _, r in faers.iterrows():
            d = str(r["drug"]).upper()
            tag = str(r[grpcol]).upper() if grpcol else ""
            if ("ARIA" in tag) or any(k.upper() in tag for k in ARIA_AE_KEYS):
                faers_aria_map[d] = 1

    # fuse for each drug: repurposing + synergy + safety
    fused = df_a[["drug_id", "drug", "gnn_repurpose_score"]].copy()
    fused = fused.merge(df_b[["drug_id", "gnn_mitigation_score", "max_aria_risk"]],
                        on="drug_id", how="left")
    fused = fused.merge(df_c[["drug_id", "gnn_synergy_score", "n_targets",
                              "n_ad_prior_targets", "ad_prior_targets",
                              "n_synergy_pathways"]], on="drug_id", how="left")
    fused["is_cns"] = fused["drug"].astype(str).str.upper().map(cns_map).fillna(0).astype(int)
    fused["faers_aria_signal"] = fused["drug"].astype(str).str.upper().map(faers_aria_map).fillna(0).astype(int)
    fused["mr_target_evidence"] = fused["ad_prior_targets"].fillna("").apply(
        lambda s: int(any(g in mr_sig_genes for g in str(s).split(",") if g)))
    fused["coloc_target_evidence"] = fused["ad_prior_targets"].fillna("").apply(
        lambda s: int(any(g in coloc_genes for g in str(s).split(",") if g)))

    # composite fusion score (equal-weight z-free min-max normalisation)
    def _mm(x):
        x = pd.to_numeric(x, errors="coerce").fillna(0.0)
        lo, hi = float(x.min()), float(x.max())
        return (x - lo) / (hi - lo) if hi > lo else x * 0.0

    fused["f_score"] = (
        0.40 * _mm(fused["gnn_repurpose_score"]) +
        0.25 * _mm(fused["gnn_synergy_score"]) +
        0.15 * _mm(fused["gnn_mitigation_score"]) +
        0.10 * fused["mr_target_evidence"].astype(float) +
        0.10 * fused["coloc_target_evidence"].astype(float)
    )
    fused = fused.sort_values("f_score", ascending=False).reset_index(drop=True)
    fused["rank"] = np.arange(1, len(fused) + 1)

    # write all tables
    df_a.to_csv(tdir / "repositioning_candidates.csv", index=False)
    df_b.to_csv(tdir / "combination_mitigation.csv", index=False)
    df_c.to_csv(tdir / "combination_synergy.csv", index=False)
    fused.to_csv(tdir / "fusion_top_candidates.csv", index=False)

    log("[A] top repurposing -> %s", str(tdir / "repositioning_candidates.csv"))
    log("[B] top mitigation  -> %s", str(tdir / "combination_mitigation.csv"))
    log("[C] top synergy     -> %s", str(tdir / "combination_synergy.csv"))
    log("[F] fused ranking   -> %s", str(tdir / "fusion_top_candidates.csv"))

    # ------------------------------------------------ figures
    _plot_figures(proj, df_a, df_b, df_c, fused)

    log("--- TOP 15 fused candidates ---")
    show = fused.head(15)[["rank", "drug", "f_score", "gnn_repurpose_score",
                           "gnn_mitigation_score", "gnn_synergy_score",
                           "mr_target_evidence", "coloc_target_evidence",
                           "faers_aria_signal", "is_cns"]]
    for _, r in show.iterrows():
        log("  #%-3d %-28s f=%.3f  repurp=%.3f  mitig=%.3f  syn=%.3f  "
            "MR=%d coloc=%d ARIA=%d CNS=%d",
            int(r["rank"]), str(r["drug"])[:28], r["f_score"],
            r["gnn_repurpose_score"], r["gnn_mitigation_score"],
            r["gnn_synergy_score"], int(r["mr_target_evidence"]),
            int(r["coloc_target_evidence"]), int(r["faers_aria_signal"]),
            int(r["is_cns"]))
    log("done.")
    return fused


def _plot_figures(proj, df_a, df_b, df_c, fused):
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except Exception as e:
        log("  [warn] matplotlib unavailable: %s", e)
        return

    fdir = proj / "results" / "figures"
    fdir.mkdir(parents=True, exist_ok=True)

    # training curve
    met = proj / "results" / "tables" / "gnn_hgt_metrics.json"
    if met.exists():
        try:
            m = json.loads(met.read_text(encoding="utf-8"))
            h = m.get("history", [])
            if h:
                ep = [x["epoch"] for x in h]
                auc = [x["val_auc"] for x in h]
                loss = [x["loss"] for x in h]
                fig, ax1 = plt.subplots(figsize=(7, 4))
                ax1.plot(ep, auc, color="tab:blue", label="val AUC")
                ax1.set_xlabel("epoch"); ax1.set_ylabel("val macro AUC", color="tab:blue")
                ax2 = ax1.twinx()
                ax2.plot(ep, loss, color="tab:red", alpha=0.6, label="train loss")
                ax2.set_ylabel("train loss", color="tab:red")
                plt.title("HGT link-prediction training")
                fig.tight_layout()
                fig.savefig(fdir / "gnn_hgt_training_curve.png", dpi=140)
                plt.close(fig)
        except Exception as e:
            log("  [warn] training curve failed: %s", e)

    # top-20 fused bar
    try:
        top = fused.head(20).iloc[::-1]
        fig, ax = plt.subplots(figsize=(8, 6))
        ax.barh(top["drug"].astype(str), top["f_score"], color="#2a9d8f")
        ax.set_xlabel("fused score")
        ax.set_title("Top-20 repurposing / combination candidates")
        fig.tight_layout()
        fig.savefig(fdir / "gnn_hgt_top20_fused.png", dpi=140)
        plt.close(fig)
    except Exception as e:
        log("  [warn] fused bar failed: %s", e)


# =============================================================================
# 8. CLI
# =============================================================================

def parse_args(argv):
    ap = argparse.ArgumentParser(
        description="Chapter 6: HGT link prediction for drug repurposing "
                    "and combination therapy in AD anti-amyloid safety.")
    ap.add_argument("stage", choices=["probe", "train", "predict", "all"])
    ap.add_argument("--proj", default=".", help="project root")
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--epochs", type=int, default=200)
    ap.add_argument("--eval-every", type=int, default=10)
    ap.add_argument("--patience", type=int, default=8)
    ap.add_argument("--hidden", type=int, default=128)
    ap.add_argument("--dim", type=int, default=128)
    ap.add_argument("--heads", type=int, default=4)
    ap.add_argument("--layers", type=int, default=2)
    ap.add_argument("--dropout", type=float, default=0.2)
    ap.add_argument("--lr", type=float, default=5e-3)
    ap.add_argument("--max-pos-per-rel", type=int, default=3000)
    ap.add_argument("--val-frac", type=float, default=0.10)
    ap.add_argument("--test-frac", type=float, default=0.10)
    ap.add_argument("--device", default="cpu")
    return ap.parse_args(argv)


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])
    proj = find_proj_root(args.proj)
    check_disk(proj, 2.0)
    log("project root: %s", proj)
    if args.stage == "probe":
        stage_probe(proj, args)
    elif args.stage == "train":
        stage_train(proj, args)
    elif args.stage == "predict":
        stage_predict(proj, args)
    elif args.stage == "all":
        stage_probe(proj, args)
        stage_train(proj, args)
        stage_predict(proj, args)


if __name__ == "__main__":
    main()
